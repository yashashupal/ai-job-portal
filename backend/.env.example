DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated frontend origins allowed to call this API (no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Leave empty locally to use SQLite. On Render/Neon this is a Postgres URL.
DATABASE_URL=
# Paste your JobsPipe key here (or in the Render dashboard). Never commit it.
JOBSPIPE_API_KEY=
JOBSPIPE_BASE_URL=https://api.jobspipe.dev
# Gemini is used server-side for resume embeddings and match explanations.
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_TEXT_FALLBACK_MODEL=gemini-3.5-flash
